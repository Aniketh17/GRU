{
  // GRU: Workers Free only. test/unit/config.test.ts fails the build if a paid-only
  // setting or binding appears here (DECISIONS A8, ARCHITECTURE section 9).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gru",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,

  // Workers Logs pricing changes on 2026-12-01 and new Workers default to enabled (D-020).
  "observability": { "enabled": false },

  // Every request goes through the Worker so security headers apply to assets too (D-010).
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gru",
      // Replace with the id printed by `npx wrangler d1 create gru` (SETUP step 3).
      "database_id": "88c2d5d9-299c-42b5-b983-83395ed50084",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI is used only for the natural speaking voice (Aura-1, DECISIONS D-055). The Free plan allows 10,000 Neurons/day
  // and FAILS (never bills) beyond that; the app also caps itself at TTS_DAILY_CHARS characters/day, well below the allowance.
  "ai": { "binding": "AI" },

  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    // Set to https://gru.<subdomain>.workers.dev before deploying (SETUP step 3).
    "APP_ORIGIN": "https://gru.aniketh123ani.workers.dev"
  }
}
