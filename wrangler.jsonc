{
  // GRU: Workers Free only. test/unit/config.test.ts fails the build if a paid-only
  // setting or binding appears here (DECISIONS A8, ARCHITECTURE section 9).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gru",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,

  // Workers Logs pricing changes on 2026-12-01 and new Workers default to enabled (D-020).
  "observability": { "enabled": false },

  // Every request goes through the Worker so security headers apply to assets too (D-010).
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gru",
      // Replace with the id printed by `npx wrangler d1 create gru` (SETUP step 3).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": { "crons": ["*/15 * * * *"] },

  "vars": {
    // Set to https://gru.<subdomain>.workers.dev before deploying (SETUP step 3).
    "APP_ORIGIN": "http://localhost:8787"
  }
}
