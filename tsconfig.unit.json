{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "build/unit",
    "rootDir": ".",
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "test/unit/**/*.ts",
    "scripts/**/*.ts",
    "apps/worker/src/**/*.ts",
    "apps/web/src/derive.ts",
    "apps/web/src/lib/voice-intents.ts",
    "apps/web/src/lib/theme-core.ts",
    "test/fixtures/**/*.ts"
  ]
}
