{
  "name": "gru",
  "version": "0.1.0",
  "private": true,
  "description": "GRU: Ani's private job-search assistant (single-user, $0, Cloudflare Workers Free)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:web": "vite build",
    "dev": "npm run build:web && wrangler dev",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.unit.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "lint:console": "node scripts/check-console.mjs",
    "build:unit": "node scripts/clean-build.mjs && tsc -p tsconfig.unit.json",
    "test:unit": "npm run build:unit && node scripts/run-unit.mjs",
    "test:integration": "npm run build:web && vitest run --config vitest.integration.config.ts",
    "test": "npm run test:unit && npm run test:integration",
    "e2e": "npm run build:web && npm run build:unit && node scripts/e2e-prepare.mjs && playwright test",
    "check": "npm run typecheck && npm run lint && npm run lint:console && npm test",
    "db:migrate:local": "wrangler d1 migrations apply gru --local",
    "db:migrate:remote": "wrangler d1 migrations apply gru --remote",
    "deploy": "npm run check && wrangler deploy",
    "upgrade-check": "npm outdated",
    "eval:synthetic": "npm run build:unit && node build/unit/scripts/eval-synthetic.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.105.0",
    "hash-wasm": "4.12.0",
    "hono": "4.13.16",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
