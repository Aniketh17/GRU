# Copy to .dev.vars (git-ignored) for `wrangler dev`.
# Use THROWAWAY values generated with the scripts. Never use production keys here.
#   node build/unit/scripts/gen-keys.js      -> DATA_KEY_V1, INDEX_KEY, SESSION_SECRET
#   node build/unit/scripts/set-password.js  -> AUTH_USERNAME, AUTH_VERIFIER
# AUTH_VERIFIER contains "$": write every "$" as "\$" (wrangler expands $names in env files, even when quoted).
DATA_KEY_V1=
INDEX_KEY=
SESSION_SECRET=
AUTH_USERNAME=
AUTH_VERIFIER=
